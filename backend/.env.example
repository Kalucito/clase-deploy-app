# Valores de ejemplo para desarrollo local (sin credenciales reales)
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public
# Si el puerto 5432 está ocupado: TASKFLOW_DB_PORT=5434 docker compose up -d y usar ese puerto en la URL
# Base alternativa para los tests e2e:
# DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
